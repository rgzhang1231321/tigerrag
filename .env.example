POSTGRES_DB=ragdb
POSTGRES_USER=tigerrag
POSTGRES_PASSWORD=And@2088

MINIO_ROOT_USER=tigerrag
MINIO_ROOT_PASSWORD=And@2088

JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=TigerRAG
JWT_AUDIENCE=TigerRAG
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-password

REDIS_PASSWORD=123456

# Root directories for all bind mounts (data + static config). Defaults
# are ./data and ./config resolved against deploy/. On WSL with the repo
# mounted from /mnt/c, /mnt/d via DrvFS/9P, override both to native ext4
# paths: postgres 18's initdb needs POSIX chmod and Docker Desktop's
# bind-mount layer mishandles file-type detection on the Windows-backed
# filesystem (a regular file can be reported as a directory).
# DATA_ROOT=/home/your-user/tigerrag/data
# CONFIG_ROOT=/home/your-user/tigerrag/config
