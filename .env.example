# TigerRAG 环境变量示例。
# 复制为 .env 后按需修改;docker-compose 与本地开发期的 .env 加载器
# (LocalDotEnvConfigurationExtensions) 都会读取此文件中的同名键。
# 只有 ASPNETCORE_ENVIRONMENT=DOTNET_ENVIRONMENT 处于 Development 或 Test 时
# 才会启用 .env 加载;生产环境请直接通过容器 env 或 KeyVault 注入。

# ---- PostgreSQL ----
# 既被 docker-compose 的 postgres 服务直接消费,
# 也会被 .env 加载器组装为 ConnectionStrings:PostgreSql(Host=postgres;...)。
POSTGRES_DB=ragdb
POSTGRES_USER=tigerrag
POSTGRES_PASSWORD=changeme

# ---- Redis ----
# docker-compose 通过 ${REDIS_PASSWORD:?...} 强制要求,启动期缺失会直接报错;
# .env 加载器会把它折进 ConnectionStrings:Redis 作为 password=... 段。
REDIS_PASSWORD=changeme

# ---- MinIO ----
# 既被 minio 镜像读取作为 ROOT 凭据,
# 也由 .env 加载器映射为 Services:Minio:AccessKey / Services:Minio:SecretKey。
MINIO_ROOT_USER=tigerrag
MINIO_ROOT_PASSWORD=changeme

# ---- JWT (HS256) ----
# SigningKey 必须 ≥ 32 字节 UTF-8,ApiComposition 与 JwtAccessTokenIssuer 都会校验,
# 长度不足时启动抛出 InvalidOperationException。
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes-here
JWT_ISSUER=TigerRAG
JWT_AUDIENCE=TigerRAG

# ---- 引导管理员 ----
# 仅当 API 以 --bootstrap-admin 参数启动时才会被 AdminBootstrapCommand 读取,
# 用于一次性创建初始管理员账号;其他时刻可不设置。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-password

# ---- 卷挂载根目录(可选) ----
# docker-compose 与 deploy/deploy.sh 通过 ${DATA_ROOT:-./data} / ${CONFIG_ROOT:-./config}
# 解析,默认相对 deploy/ 目录。
# 在 WSL(仓库挂载于 /mnt/c 或 /mnt/d 的 DrvFS/9P)下必须改写为原生 ext4 路径:
# postgres 18 的 initdb 需要 POSIX chmod,而 Docker Desktop 在 Windows 后端文件系统
# 上的 bind-mount 层会把常规文件误判为目录,导致数据卷初始化失败。
# DATA_ROOT=/home/<user>/tigerrag/data
# CONFIG_ROOT=/home/<user>/tigerrag/config

# ---- 可选:令牌 TTL 与时钟宽限(不走 .env 加载器,需以双下划线语法直接注入到容器 env) ----
# 对应 JwtOptions.AccessTokenMinutes / ClockSkewSeconds 与 RefreshTokenOptions.LifetimeDays,
# 缺省分别为 15 分钟、30 秒、7 天。.env 加载器不会翻译这些键,删除下面注释即可覆盖。
# Jwt__AccessTokenMinutes=15
# Jwt__ClockSkewSeconds=30
# RefreshToken__LifetimeDays=7

# ---- 可选:API 运行日志(api_log 表) ----
# TigerRagSqlLoggerProvider 把 Warning/Error/Critical 批量写入 api_log;
# 缺省连接串回落 ConnectionStrings:PostgreSql,要拆出去的话取消下面这一行注释,
# 填入独立 PG 实例即可。LogLevelToEnableMap 用 LogLevel 名作为子键、值 true/false。
# ApiLog__ConnectionStringKey=Logging
# ConnectionStrings__Logging=Host=logger;Database=apilog;Username=logger;Password=...
# ApiLog__BatchSize=100
# ApiLog__FlushInterval=00:00:30
# ApiLog__LogLevelToEnableMap__Warning=true
# ApiLog__LogLevelToEnableMap__Error=true
# ApiLog__LogLevelToEnableMap__Critical=true

# ---- 可选:本地开发期 ASP.NET 环境 ----
# 仅在容器外 dotnet run 时需要显式设置;compose 内已硬编码为 Development。
# ASPNETCORE_ENVIRONMENT=Development
